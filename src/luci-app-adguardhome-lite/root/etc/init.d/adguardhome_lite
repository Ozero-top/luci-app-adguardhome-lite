#!/bin/sh /etc/rc.common
# AdGuard Home 助手 - 服务控制脚本
# 说明：由 procd 管理，负责首次配置、DNS 接管、启动/停止与失败恢复。

USE_PROCD=1
START=95
STOP=01

. /usr/share/adguardhome-lite/common.sh

start_service() {
    load_conf

    if [ "$enabled" != "1" ]; then
        log_msg "AdGuard Home 当前设置为未启用，跳过启动。"
        return 0
    fi

    if [ ! -x "$binpath" ]; then
        log_msg "未找到可执行内核：$binpath。请先在 LuCI 概览页安装内核。"
        return 1
    fi

    mkdir -p "$workdir" "$(dirname "$configpath")" 2>/dev/null

    # 首次启动：调用官方安装 API 自动生成配置和管理员密码
    if [ ! -s "$configpath" ]; then
        log_msg "未找到配置文件，开始首次自动配置..."
        if ! /usr/share/adguardhome-lite/bootstrap.sh; then
            log_msg "首次自动配置失败，服务未启动。"
            return 1
        fi
    fi

    if ! check_agh_config; then
        log_msg "配置文件校验失败：$(cat /var/run/adguardhome_lite_check.log 2>/dev/null | tail -n 5 | tr '\n' ' ')"
        return 1
    fi

    # 串联模式的 AdGuard Home 上游是 Clash DNS；Clash 已在运行但端口未就绪时，
    # 先等待其监听，避免 AdGuard Home 启动即解析失败。
    if [ "$dns_mode" = "openclash" ] && pidof clash >/dev/null 2>&1; then
        _wi=0
        while [ "$_wi" -lt 10 ]; do
            port_listening "$clash_dns_port" && break
            sleep 1
            _wi=$(( _wi + 1 ))
        done
        if ! port_listening "$clash_dns_port"; then
            log_msg "等待 Clash DNS（$clash_dns_port）超时，OpenClash 可能尚未就绪。"
        fi
    fi

    # 应用 DNS 接管方式；失败不阻止内核启动，但会记录原因
    if ! /usr/share/adguardhome-lite/dns_mode.sh apply; then
        log_msg "DNS 接管设置失败，将继续启动 AdGuard Home。"
    fi

    procd_open_instance "adguardhome"
    procd_set_param command "$binpath" -c "$configpath" -w "$workdir" --no-check-update
    procd_set_param respawn 3600 5 5
    procd_set_param file "$configpath"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited" nofile="65535 65535"
    procd_close_instance

    # 启动失败保护：12 秒内没有进程则停止服务并恢复 DNSMasq，避免断网
    (
        sleep 12
        . /usr/share/adguardhome-lite/common.sh
        load_conf
        [ "$enabled" = "1" ] || exit 0
        if ! is_agh_running; then
            log_msg "AdGuard Home 未能在 12 秒内运行，正在恢复 DNSMasq 设置..."
            /etc/init.d/adguardhome_lite stop >/dev/null 2>&1
            /usr/share/adguardhome-lite/dns_mode.sh revert >/dev/null 2>&1
            restart_dnsmasq
        fi
    ) &
}

stop_service() {
    log_msg "正在停止 AdGuard Home..."
}

service_stopped() {
    # 此钩子在 procd 结束进程之后执行；若仍有残留进程则强制结束
    force_stop_agh
    /usr/share/adguardhome-lite/dns_mode.sh revert
    log_msg "AdGuard Home 已停止，DNSMasq 设置已恢复。"
}
